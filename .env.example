IRE_ENV=development
JWT_SECRET_KEY=change-me-dev-only
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_AUDIENCE=
IRE_TENANT_CLAIM=tenant_id
IRE_ROLE_CLAIM=role
IRE_DOMAIN_IDS_CLAIM=domain_ids
IRE_SUBJECT_ID_CLAIM=sub
# Provider control plane uses a separate OIDC application and never accepts tenant roles.
IRE_PROVIDER_JWKS_URL=
IRE_PROVIDER_ISSUER=
IRE_PROVIDER_AUDIENCE=
IRE_PROVIDER_ROLE_CLAIM=platform_role
VITE_PROVIDER_OIDC_AUTHORITY=
VITE_PROVIDER_OIDC_CLIENT_ID=
VITE_PROVIDER_OIDC_SCOPE=openid profile email
VITE_PROVIDER_OIDC_AUDIENCE=
VITE_APP_SURFACE=tenant
IRE_TRUST_PROXY_HEADERS=false
IRE_ALLOWED_HOSTS=localhost,127.0.0.1
IRE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_RATE_LIMIT_SALT=change-me-in-production
PUBLIC_SUPPORT_RATE_LIMIT_MAX=5
PUBLIC_SUPPORT_RATE_LIMIT_WINDOW_SECONDS=3600
SUPPORT_REQUEST_RETENTION_DAYS=90
DECISION_REVIEW_RETENTION_DAYS=365
HANDBOOK_UPLOAD_MAX_BYTES=262144000
HANDBOOK_DIRECT_UPLOAD_MAX_BYTES=2147483647
HANDBOOK_UPLOAD_SESSION_TTL_SECONDS=900
SYSTEM_RECORD_IMPORT_MAX_BYTES=20000000
REFERENCE_EVIDENCE_MAX_BYTES=250000
DATABASE_URL=sqlite+aiosqlite:///./reasoning_engine.db
IRE_AUTO_CREATE_SCHEMA=false
IRE_RETENTION_TENANT_IDS=
IRE_WORKER_TENANT_IDS=
IRE_WORKER_ID=
IRE_BACKGROUND_JOB_LEASE_SECONDS=900
IRE_BACKGROUND_JOB_POLL_SECONDS=5
IRE_BACKGROUND_JOB_SIGNAL_QUEUE_URL=
# Production must use postgresql+asyncpg and reviewed Alembic migrations.
REDIS_URL=
IRE_EDGE_ROOT=

REASONING_ENGINE_AI_PROVIDER=mock
OPENAI_API_KEY=
IRE_ALLOW_EXTERNAL_AI_PROCESSING=false
IRE_EXTERNAL_AI_APPROVAL_REFERENCE=
EXTERNAL_AI_MAX_INPUT_BYTES=200000

GOVERNANCE_PRIVATE_KEY=
GOVERNANCE_KEY_ID=

S3_BUCKET_NAME=
S3_SERVER_SIDE_ENCRYPTION=AES256

OCR_PROVIDER_URL=
OCR_PROVIDER_NAME=institution_ocr
OCR_PROVIDER_API_KEY=
OCR_PROVIDER_TIMEOUT_SECONDS=120
# OCR is off unless a tenant has explicitly approved this external processor.
IRE_ALLOW_EXTERNAL_OCR_PROCESSING=false
IRE_EXTERNAL_OCR_APPROVAL_REFERENCE=
# Keep provider requests and document cost bounded even when a source is large.
OCR_MAX_PAGES_PER_JOB=250
OCR_MAX_PAGES_PER_REQUEST=25
OCR_ALLOWED_PROVIDER_HOSTS=
OCR_PROVIDER_MODEL_VERSION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
